{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "watchPatterns": ["server/**", "package.json", "package-lock.json", ".nvmrc", "railway.json"]
  },
  "deploy": {
    "startCommand": "node --experimental-sqlite server/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
